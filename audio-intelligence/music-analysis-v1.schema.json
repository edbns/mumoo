{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUMOO Music Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "source",
    "clip",
    "rhythm",
    "features",
    "provenance",
    "metrics"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "method": {
      "const": "beat_this_librosa"
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offsetMs",
        "durationMs",
        "sha256",
        "receivedAudio"
      ],
      "properties": {
        "offsetMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "const": 15000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receivedAudio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durationMs",
            "codec",
            "sampleRateHz",
            "channels"
          ],
          "properties": {
            "durationMs": {
              "type": "integer",
              "minimum": 1
            },
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "sampleRateHz": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "beatsMs",
        "downbeatsMs",
        "tempo"
      ],
      "properties": {
        "status": {
          "enum": [
            "detected",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "beatsMs": {
          "$ref": "#/$defs/events"
        },
        "downbeatsMs": {
          "$ref": "#/$defs/events"
        },
        "tempo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "bpm",
            "gridBpm",
            "alternativesBpm",
            "intervalCount",
            "supportFraction"
          ],
          "properties": {
            "status": {
              "enum": [
                "estimated",
                "ambiguous",
                "unavailable"
              ]
            },
            "bpm": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "gridBpm": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "alternativesBpm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "intervalCount": {
              "type": "integer",
              "minimum": 0
            },
            "supportFraction": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleRateHz",
        "windowSamples",
        "hopSamples",
        "frameTime",
        "transientsMs",
        "frames"
      ],
      "properties": {
        "sampleRateHz": {
          "type": "integer",
          "minimum": 1
        },
        "windowSamples": {
          "type": "integer",
          "minimum": 1
        },
        "hopSamples": {
          "type": "integer",
          "minimum": 1
        },
        "frameTime": {
          "const": "center"
        },
        "transientsMs": {
          "$ref": "#/$defs/events"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeMs",
              "rms",
              "onsetStrength",
              "centroidHz",
              "bandwidthHz",
              "rolloffHz"
            ],
            "properties": {
              "timeMs": {
                "$ref": "#/$defs/event"
              },
              "rms": {
                "type": "number",
                "minimum": 0
              },
              "onsetStrength": {
                "type": "number",
                "minimum": 0
              },
              "centroidHz": {
                "type": "number",
                "minimum": 0
              },
              "bandwidthHz": {
                "type": "number",
                "minimum": 0
              },
              "rolloffHz": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beatModel",
        "librosaVersion",
        "contextMs"
      ],
      "properties": {
        "beatModel": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "checkpointSha256"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "checkpointSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "librosaVersion": {
          "type": "string",
          "minLength": 1
        },
        "contextMs": {
          "const": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallSeconds",
        "pythonCpuSeconds",
        "childCpuSeconds",
        "peakPythonRssBytes",
        "decodeSeconds",
        "featureSeconds",
        "beatLoadSeconds",
        "beatInferenceSeconds"
      ],
      "properties": {
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "pythonCpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "childCpuSeconds": {
          "type": "number",
          "minimum": 0
        },
        "peakPythonRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "decodeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "featureSeconds": {
          "type": "number",
          "minimum": 0
        },
        "beatLoadSeconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "beatInferenceSeconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "firstInContainer": {
          "type": "boolean"
        }
      }
    },
    "temporalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "durationMs",
        "frequencyBandsHz",
        "energyNormalization",
        "bandNormalization",
        "changeThreshold",
        "bins",
        "segments"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "durationMs": {
          "const": 15000
        },
        "frequencyBandsHz": {
          "const": {
            "low": [
              20,
              250
            ],
            "lowMid": [
              250,
              500
            ],
            "midHighMid": [
              500,
              4000
            ],
            "high": [
              4000,
              8000
            ]
          }
        },
        "energyNormalization": {
          "type": "string"
        },
        "bandNormalization": {
          "type": "string"
        },
        "changeThreshold": {
          "const": 0.22
        },
        "bins": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startMs",
              "endMs",
              "relativeEnergy",
              "bandShares",
              "onsetCount"
            ],
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15000
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15000
              },
              "relativeEnergy": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bandShares": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "lowMid",
                  "midHighMid",
                  "high"
                ],
                "properties": {
                  "low": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lowMid": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "midHighMid": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "high": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "onsetCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startMs",
              "endMs",
              "relativeEnergy",
              "bandShares",
              "onsetsPerSecond",
              "beatCount",
              "energyChange"
            ],
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15000
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15000
              },
              "relativeEnergy": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bandShares": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "lowMid",
                  "midHighMid",
                  "high"
                ],
                "properties": {
                  "low": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lowMid": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "midHighMid": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "high": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "onsetsPerSecond": {
                "type": "number",
                "minimum": 0
              },
              "beatCount": {
                "type": "integer",
                "minimum": 0
              },
              "energyChange": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "integer",
      "minimum": 0,
      "maximum": 14999
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
